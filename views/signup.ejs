<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>AuthX</title>
</head>

<body>
    <div class="w-full h-screen bg-[black] text-white px-10 py-20 flex item-center justify-center">
        <div class=" w-fit flex flex-col px-7 h-fit rounded-lg py-10 min-w-sm bg-[#181818]">
            <h1 class="text-4xl my-4 text-center">Create User</h1>
            <form action="/signup" method="post" class="flex gap-4 flex-col">
                <input type="text" name="name" placeholder="Enter a Name"
                    class="  rounded-md px-3 py-2 border border-[#262C36] outline-none ">
                <input type="text" name="email" placeholder="Enter Your Email"
                    class="  rounded-md px-3 py-2 border border-[#262C36] outline-none ">
                <input type="password" name="password" placeholder="Enter Your Password"
                    class="  rounded-md px-3 py-2 border border-[#262C36] outline-none ">
                <input type="submit" value="Create"
                    class="cursor-pointer w-full bg-blue-500  text-black font-bold text-2xl rounded-md px-3 py-2 ">
            </form>
            <a href="/" class=" text-center text-xl py-3 rounded-lg bg-[#D08700] text-black font-bold my-3">Back to Home</a>
        </div>
    </div>
</body>

</html>
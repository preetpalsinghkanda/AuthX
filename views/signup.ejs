<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>AuthX</title>
</head>

<body>

    <div class="w-full h-screen bg-[black] text-white px-10 py-20">
        <h1 class="text-2xl my-4">Create User</h1>
 
        <form action="/signup" method="post" class="flex gap-4">


                
            <input type="text" name="name" placeholder="Enter a Name"
                class="  rounded-md px-3 py-2 border border-[#262C36] outline-none ">


            <input type="text" name="email" placeholder="Enter Your Email"
                class="  rounded-md px-3 py-2 border border-[#262C36] outline-none ">
            <input type="password" name="password" placeholder="Enter Your Password"
                class="  rounded-md px-3 py-2 border border-[#262C36] outline-none ">
            
            <input type="submit"
                class="cursor-pointer bg-blue-500  mx-6 rounded-md px-3 py-2  outline-zinc-200 outline">

        </form>

    </div>

</body>

</html>
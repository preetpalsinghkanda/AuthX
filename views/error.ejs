<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>AuthX</title>
</head>

<body>

    <div class="w-full h-screen bg-[black] text-white px-10 py-20  flex flex-col">
        <h1 class="text-4xl my-4">Error : Something Went Wrong</h1>
        <hr>
        <div class="flex flex-col w-fit gap-4 text-3xl my-4">

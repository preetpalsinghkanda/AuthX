        </div>

        <div class="my-4 flex gap-10">
             <a href="/" class=" px-4 py-1 rounded-lg bg-blue-400 text-xl font-bold text-black">Home</a>
            <a href="/login" class=" px-4 py-1 rounded-lg bg-blue-400 text-xl font-bold text-black">Login</a>
            <a href="/signup" class="px-4 py-1 rounded-lg bg-blue-400 text-xl font-bold text-black">Signup</a>
        </div>
    </div>

</body>

</html>
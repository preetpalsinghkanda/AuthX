<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>AuthX</title>
</head>

<body>

    <div class="w-full h-screen bg-[black] text-white px-10 py-20">
        <h1 class="text-2xl my-4">All Users</h1>
        <div class="flex flex-col w-fit gap-4">

            <ul class="flex flex-wrap gap-4">

                <% allusers.forEach(user=>{ %>

                    
                    <li>
                        <div class="flex flex-col border px-2 py-2 rounded-md"><span>name : <%= user.name %></span>
                            <span>Email : <%= user.email %></span>
                            <span>isAdmin : <%= user.isAdmin %></span>
                            <div class="flex gap-4 ">
                                <form method="post" action="/edit/<%= user._id%>"> <button class="text-zinc-500 cursor-pointer">Edit User</button></form>
                                    <form method="post" action="/delete/<%= user._id%>"> <button class="text-red-500 cursor-pointer">Delete User</button></form>
                                  
                            </div>
                        </div>

                    </li>

                    <% }) %>



            </ul>

        </div>
    </div>

</body>

</html>